{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soorma.ai/schemas/monitoring/dashboard.schema.json",
  "$comment": "SPDX-License-Identifier: FSL-1.1-ALv2. deploy/monitoring/dashboard.yaml (NFR-OI-23; SECURITY-14).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "panels"],
  "properties": {
    "version": { "const": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 100 },
    "panels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "events", "windowMinutes"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 64 },
          "title": { "type": "string", "minLength": 1, "maxLength": 100 },
          "events": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z_]+(\\.[a-z_]+)+$", "maxLength": 64 }
          },
          "groupBy": { "enum": ["pseudonym", "environment", "code"] },
          "windowMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 }
        }
      }
    }
  }
}
