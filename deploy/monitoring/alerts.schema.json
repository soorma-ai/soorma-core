{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soorma.ai/schemas/monitoring/alerts.schema.json",
  "$comment": "SPDX-License-Identifier: FSL-1.1-ALv2. deploy/monitoring/alerts.yaml (NFR-OI-23; SECURITY-14).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "events", "rules"],
  "properties": {
    "version": { "const": 1 },
    "events": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/EventName" }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Rule" }
    }
  },
  "$defs": {
    "EventName": { "type": "string", "pattern": "^[a-z_]+(\\.[a-z_]+)+$", "maxLength": 64 },
    "Rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "event", "groupBy", "threshold", "severity", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 64 },
        "event": { "$ref": "#/$defs/EventName" },
        "groupBy": { "enum": ["none", "pseudonym", "environment", "code", "agent"] },
        "codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z_]+$", "maxLength": 64 }
        },
        "threshold": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "windowMinutes"],
          "properties": {
            "count": { "type": "integer", "minimum": 1 },
            "windowMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 }
          }
        },
        "severity": { "enum": ["info", "warning", "critical"] },
        "description": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    }
  }
}
