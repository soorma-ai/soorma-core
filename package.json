{
  "name": "soorma-core",
  "private": true,
  "type": "module",
  "license": "FSL-1.1-ALv2",
  "engines": {
    "node": "^26.13.0"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "pnpm run generate && pnpm run typecheck && tsc -b tsconfig.build.json",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:perf": "SOORMA_PERF=1 vitest run services/org-gateway/test/perf",
    "generate": "pnpm --filter @soorma/contract run generate",
    "check:generated": "pnpm --filter @soorma/contract run check:generated",
    "check:contract": "pnpm --filter @soorma/contract run check",
    "check:deps": "node tools/checks/run.ts register licence configuration",
    "check:workflows": "node tools/checks/run.ts workflows",
    "check:github": "node tools/checks/run.ts github-settings",
    "check:breached": "node tools/checks/run.ts breached",
    "check:secrets": "node tools/checks/run.ts secrets",
    "check:code": "node tools/checks/run.ts sql compare inject",
    "stack:init": "node --conditions=source deploy/local/scripts/stack-init.ts",
    "stack:certs": "node --conditions=source deploy/local/scripts/stack-certs.ts",
    "stack:up": "docker compose -f deploy/local/compose.yaml up -d --build --wait",
    "stack:down": "docker compose -f deploy/local/compose.yaml down",
    "stack:smoke": "node deploy/local/scripts/smoke.ts",
    "db:test": "node deploy/local/scripts/db-test.ts start",
    "db:test:stop": "node deploy/local/scripts/db-test.ts stop"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
