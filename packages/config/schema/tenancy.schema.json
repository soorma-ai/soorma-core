{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soorma.ai/schemas/tenancy.schema.json",
  "$comment": "SPDX-License-Identifier: FSL-1.1-ALv2. tenancy.yaml: the organization, its projects and environments, and the organization level's settings (BR-CFG; D-CG-OI-12). Closed at every level. It holds no secret: secrets are named, and read from the secrets directory.",
  "type": "object",
  "additionalProperties": false,
  "required": ["organization", "secondFactorRequired", "organizationLevel", "projects"],
  "properties": {
    "organization": {
      "$ref": "#/$defs/ConfiguredIdentifier"
    },
    "secondFactorRequired": {
      "type": "boolean"
    },
    "organizationLevel": {
      "$ref": "#/$defs/OrganizationLevel"
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/Project"
      }
    }
  },
  "$defs": {
    "ConfiguredIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$"
    },
    "HumanPrincipalIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9!#$%&'*+/=?^_`{|}~.@:-]+$"
    },
    "SecretName": {
      "description": "A file name in the secrets directory. No path separator, so it cannot leave the directory.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "KeyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "Port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "Project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "environments"],
      "properties": {
        "id": {
          "$ref": "#/$defs/ConfiguredIdentifier"
        },
        "environments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/Environment"
          }
        }
      }
    },
    "Environment": {
      "description": "An environment's part names its first Admin by identifier only. It has no field for material, so it cannot carry any (BR-CFG-02).",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "firstAdmin"],
      "properties": {
        "id": {
          "$ref": "#/$defs/ConfiguredIdentifier"
        },
        "firstAdmin": {
          "$ref": "#/$defs/HumanPrincipalIdentifier"
        },
        "sealKeys": {
          "$ref": "#/$defs/SealKeys"
        },
        "controlGateway": {
          "$ref": "#/$defs/ControlGateway"
        },
        "dataGateway": {
          "$ref": "#/$defs/DataGateway"
        }
      }
    },
    "SealKeys": {
      "description": "The environment's envelope-seal key ring (U3 NFR Design NP-02), in the seed keys' shape: one current key id, and the keys by id, each naming its secret. A name is never derived from an id. Each secret is base64url text of exactly 256 bits, read only by the environment's own event transport (S4). Optional here: an environment without it cannot run S4, whose loader refuses it. Rotation is two-phase (packages/envelope/README.md).",
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "keys"],
      "properties": {
        "current": {
          "$ref": "#/$defs/KeyId"
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "secret"],
            "properties": {
              "id": {
                "$ref": "#/$defs/KeyId"
              },
              "secret": {
                "$ref": "#/$defs/SecretName"
              }
            }
          }
        }
      }
    },
    "Listener": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "tls"],
      "properties": {
        "port": {
          "$ref": "#/$defs/Port"
        },
        "tls": {
          "$ref": "#/$defs/SecretName"
        }
      }
    },
    "OrganizationLevel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge", "internal", "health", "database", "migrator", "keys", "enrollment"],
      "properties": {
        "edge": {
          "$ref": "#/$defs/Listener"
        },
        "internal": {
          "$ref": "#/$defs/Listener"
        },
        "health": {
          "type": "object",
          "additionalProperties": false,
          "required": ["port"],
          "properties": {
            "port": {
              "$ref": "#/$defs/Port"
            }
          }
        },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "port", "name", "user", "password", "ca"],
          "properties": {
            "host": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$"
            },
            "port": {
              "$ref": "#/$defs/Port"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[a-z_][a-z0-9_]*$"
            },
            "user": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[a-z_][a-z0-9_]*$"
            },
            "password": {
              "$ref": "#/$defs/SecretName"
            },
            "ca": {
              "$ref": "#/$defs/SecretName"
            }
          }
        },
        "migrator": {
          "description": "Read only by org-migrate. S1 never reads the migrator password (D-ID-OI-02).",
          "type": "object",
          "additionalProperties": false,
          "required": ["user", "password"],
          "properties": {
            "user": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[a-z_][a-z0-9_]*$"
            },
            "password": {
              "$ref": "#/$defs/SecretName"
            }
          }
        },
        "keys": {
          "type": "object",
          "additionalProperties": false,
          "required": ["signing", "seed", "counter", "logPseudonym"],
          "properties": {
            "signing": {
              "$ref": "#/$defs/SecretName"
            },
            "verify": {
              "description": "Further verify-only public keys, during a signing-key rotation (P-02).",
              "type": "array",
              "maxItems": 8,
              "items": {
                "$ref": "#/$defs/SecretName"
              }
            },
            "seed": {
              "type": "object",
              "additionalProperties": false,
              "required": ["current", "keys"],
              "properties": {
                "current": {
                  "$ref": "#/$defs/KeyId"
                },
                "keys": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id", "secret"],
                    "properties": {
                      "id": {
                        "$ref": "#/$defs/KeyId"
                      },
                      "secret": {
                        "$ref": "#/$defs/SecretName"
                      }
                    }
                  }
                }
              }
            },
            "counter": {
              "$ref": "#/$defs/SecretName"
            },
            "logPseudonym": {
              "$ref": "#/$defs/SecretName"
            }
          }
        },
        "enrollment": {
          "description": "Enrollment material, referenced only here, in the organization's part, keyed by principal identifier (BR-CFG-02).",
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["principal", "secret"],
            "properties": {
              "principal": {
                "$ref": "#/$defs/HumanPrincipalIdentifier"
              },
              "secret": {
                "$ref": "#/$defs/SecretName"
              }
            }
          }
        },
        "internalCallers": {
          "description": "Each environment's caller public keys, for signed internal requests (P-06). A list, so a caller key rotates with no outage (U4 Infrastructure Design \u00a74).",
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["environment", "publicKeys"],
            "properties": {
              "environment": {
                "$ref": "#/$defs/ConfiguredIdentifier"
              },
              "publicKeys": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "$ref": "#/$defs/SecretName"
                }
              }
            }
          }
        },
        "hashing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "budgetMiB": {
              "type": "integer",
              "minimum": 64,
              "maximum": 65536
            },
            "permits": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1024
            }
          }
        }
      }
    },
    "ControlGateway": {
      "description": "An environment's S2 control-gateway (U4 Infrastructure Design \u00a73; P-06). It names secrets only; each is read from the secrets directory by that environment's own S2 or migrate service. S2 reads only its own environment's part.",
      "type": "object",
      "additionalProperties": false,
      "required": ["edge", "health", "database", "migrator", "keys", "organizationLevel"],
      "properties": {
        "edge": {
          "$ref": "#/$defs/Listener"
        },
        "health": {
          "type": "object",
          "additionalProperties": false,
          "required": ["port"],
          "properties": {
            "port": {
              "$ref": "#/$defs/Port"
            }
          }
        },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "port", "name", "user", "password", "ca"],
          "properties": {
            "host": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$"
            },
            "port": {
              "$ref": "#/$defs/Port"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[a-z_][a-z0-9_]*$"
            },
            "user": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[a-z_][a-z0-9_]*$"
            },
            "password": {
              "$ref": "#/$defs/SecretName"
            },
            "ca": {
              "$ref": "#/$defs/SecretName"
            }
          }
        },
        "migrator": {
          "description": "Read only by {env}-migrate. S2 never reads the migrator password (NFR-EHA-14).",
          "type": "object",
          "additionalProperties": false,
          "required": ["user", "password"],
          "properties": {
            "user": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[a-z_][a-z0-9_]*$"
            },
            "password": {
              "$ref": "#/$defs/SecretName"
            }
          }
        },
        "keys": {
          "description": "E's own key ring (NP-02): each verify entry names an Ed25519 private key in PKCS #8 PEM, and signing names one of them; the caller key signs internal calls to the organization level; the log-pseudonym key is E's own (never the organization's).",
          "type": "object",
          "additionalProperties": false,
          "required": ["signing", "verify", "caller", "logPseudonym"],
          "properties": {
            "signing": {
              "$ref": "#/$defs/SecretName"
            },
            "verify": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "$ref": "#/$defs/SecretName"
              }
            },
            "caller": {
              "$ref": "#/$defs/SecretName"
            },
            "logPseudonym": {
              "$ref": "#/$defs/SecretName"
            }
          }
        },
        "organizationLevel": {
          "description": "The organization level's internal listener, as S2 calls it (NP-EHA-04): its name, port, and the CA that alone is trusted.",
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "port", "ca"],
          "properties": {
            "host": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$"
            },
            "port": {
              "$ref": "#/$defs/Port"
            },
            "ca": {
              "$ref": "#/$defs/SecretName"
            }
          }
        }
      }
    },
    "DataGateway": {
      "description": "An environment's S3 data-gateway (U6 Infrastructure Design \u00a76; D-ID-AC-10). It names secrets only; each is read from the secrets directory by that environment's own S3. It has no field for the propagation bound or a lifetime: those are code constants (NP-AC-01).",
      "type": "object",
      "additionalProperties": false,
      "required": ["edge", "health", "database", "keys", "bound"],
      "properties": {
        "edge": {
          "$ref": "#/$defs/Listener"
        },
        "health": {
          "type": "object",
          "additionalProperties": false,
          "required": ["port"],
          "properties": {
            "port": {
              "$ref": "#/$defs/Port"
            }
          }
        },
        "database": {
          "description": "S3 connects as its own role, soorma_env_data (D-ID-AC-07), never as S2's or the migrator's.",
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "port", "name", "user", "password", "ca"],
          "properties": {
            "host": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$"
            },
            "port": {
              "$ref": "#/$defs/Port"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[a-z_][a-z0-9_]*$"
            },
            "user": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[a-z_][a-z0-9_]*$"
            },
            "password": {
              "$ref": "#/$defs/SecretName"
            },
            "ca": {
              "$ref": "#/$defs/SecretName"
            }
          }
        },
        "keys": {
          "description": "E's agent key ring (D-AC-03), separate from its human ring: each verify entry names an Ed25519 private key in PKCS #8 PEM, and signing names one of them.",
          "type": "object",
          "additionalProperties": false,
          "required": ["signing", "verify"],
          "properties": {
            "signing": {
              "$ref": "#/$defs/SecretName"
            },
            "verify": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "$ref": "#/$defs/SecretName"
              }
            }
          }
        },
        "bound": {
          "description": "The bootstrap bound's counter secret: the HMAC key of its slots (D-ID-AC-06).",
          "type": "object",
          "additionalProperties": false,
          "required": ["counter"],
          "properties": {
            "counter": {
              "$ref": "#/$defs/SecretName"
            }
          }
        }
      }
    }
  }
}
